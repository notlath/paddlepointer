# Runtime: Supabase transaction pooler URI (server-side only)
DATABASE_URL=postgresql://postgres.project:password@pooler.example:6543/postgres
# Migration runner: direct or session pooler URI (server-side only)
DIRECT_DATABASE_URL=postgresql://postgres.project:password@pooler.example:5432/postgres
PP_WRITE_FREEZE=1
# Required for auth HTTP requests; generate a unique random value per environment.
BETTER_AUTH_SECRET=
# Public origin of this deployment (use its stable Vercel Preview URL there).
BETTER_AUTH_URL=http://localhost:3000
# Verified Resend sender and server-side sending key.
AUTH_EMAIL_FROM=auth@example.com
RESEND_API_KEY=
# Optional Live Board Broadcast; without these, the board polls every two seconds.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Qlik feeds: required header key for read-only /api/qlik/get-*.php routes.
ANALYTICS_KEY=
# Qlik embed: client secret and viewer subject stay server-side. Tenant, app ID, and embed client ID are public configuration.
QLIK_TENANT_URL=https://your-tenant.qlikcloud.com
QLIK_APP_ID=
QLIK_EMBED_CLIENT_ID=
QLIK_M2M_CLIENT_ID=
QLIK_M2M_CLIENT_SECRET=
QLIK_EVENT_VIEWER_SUBJECT=
# Optional triggered reload. Schedule `bun run qlik:reload-pending` every minute; keep Qlik's periodic reload as a backstop.
QLIK_RELOAD_TRIGGER_URL=
QLIK_RELOAD_TRIGGER_TOKEN=
