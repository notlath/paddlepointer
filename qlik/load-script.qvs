///$tab Main
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$ ###0.00;-$ ###0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET CreateSearchIndexOnReload=1;
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';

///$tab Section
LIB CONNECT TO 'PaddlePoint API';

RestConnectorMasterTable:
SQL SELECT 
	"ok",
	"__KEY_root",
	(SELECT 
		"id" AS "id_u0",
		"name",
		"courts",
		"matchesPerPlayer",
		"targetScore",
		"averageGameMinutes",
		"transitionMinutes",
		"bufferMinutes",
		"timingVersion",
		"winByTwo",
		"playersText",
		"generatedAt",
		"seed",
		"_shared",
		"_updatedAt",
		"__KEY_tournament",
		"__FK_tournament",
		(SELECT 
			"id",
			"round",
			"court",
			"scoreA",
			"scoreB",
			"status",
			"winner",
			"completedAt",
			"gameId",
			"durationSeconds",
			"durationMinutes",
			"startedAt",
			"startedBy",
			"activeGameId",
			"__KEY_matches",
			"__FK_matches",
			(SELECT 
				"@Value",
				"__FK_teamA"
			FROM "teamA" FK "__FK_teamA" ArrayValueAlias "@Value"),
			(SELECT 
				"@Value" AS "@Value_u0",
				"__FK_teamB"
			FROM "teamB" FK "__FK_teamB" ArrayValueAlias "@Value_u0")
		FROM "matches" PK "__KEY_matches" FK "__FK_matches")
	FROM "tournament" PK "__KEY_tournament" FK "__FK_tournament")
FROM JSON (wrap on) "root" PK "__KEY_root";

[teamA]:
LOAD	[@Value],
	[__FK_teamA] AS [__KEY_matches]
RESIDENT RestConnectorMasterTable
WHERE NOT IsNull([__FK_teamA]);


[teamB]:
LOAD	[@Value_u0] AS [@Value_u0],
	[__FK_teamB] AS [__KEY_matches]
RESIDENT RestConnectorMasterTable
WHERE NOT IsNull([__FK_teamB]);


[matches]:
LOAD	[id],
	[round],
	[court],
	[scoreA],
	[scoreB],
	[status],
	[winner],
	[completedAt],
	[gameId],
	[durationSeconds],
	[durationMinutes],
	[startedAt],
	[startedBy],
	[activeGameId],
	[__KEY_matches],
	[__FK_matches] AS [__KEY_tournament]
RESIDENT RestConnectorMasterTable
WHERE NOT IsNull([__FK_matches]);


[tournament]:
LOAD	[id_u0] AS [id_u0],
	[name],
	[courts],
	[matchesPerPlayer],
	[targetScore],
	[averageGameMinutes],
	[transitionMinutes],
	[bufferMinutes],
	[timingVersion],
	[winByTwo],
	[playersText],
	[generatedAt],
	[seed],
	[_shared],
	[_updatedAt],
	[__KEY_tournament],
	[__FK_tournament] AS [__KEY_root]
RESIDENT RestConnectorMasterTable
WHERE NOT IsNull([__FK_tournament]);


[root]:
LOAD	[ok],
	[__KEY_root]
RESIDENT RestConnectorMasterTable
WHERE NOT IsNull([__KEY_root]);


DROP TABLE RestConnectorMasterTable;



///$tab Events
LIB CONNECT TO 'PaddlePoint Analytics - Events';

EventsMasterTable:
SQL SELECT
	"__KEY_root",
	(SELECT
		"id",
		"name",
		"courts",
		"matchCount",
		"completedCount",
		"isCurrent",
		"__KEY_rows",
		"__FK_rows",
		(SELECT
			"start",
			"end",
			"__FK_eventWindow"
		FROM "eventWindow" FK "__FK_eventWindow")
	FROM "rows" PK "__KEY_rows" FK "__FK_rows")
FROM JSON (wrap on) "root" PK "__KEY_root";

[EventWindow]:
LOAD
	[start],
	[end],
	[__FK_eventWindow] AS [__KEY_rows]
RESIDENT EventsMasterTable
WHERE NOT IsNull([__FK_eventWindow]);

[Events]:
LOAD
	[id] AS [Event Id],
	[name] AS [Event Name],
	[courts] AS [Event Courts],
	[matchCount] AS [Match Count],
	[completedCount] AS [Completed Count],
	[isCurrent] AS [Is Current Event],
	[__KEY_rows]
RESIDENT EventsMasterTable
WHERE NOT IsNull([__KEY_rows]);

DROP TABLE EventsMasterTable;

///$tab Courts
LIB CONNECT TO 'PaddlePoint Analytics - Matches';

MatchesMasterTable:
SQL SELECT
	"__KEY_root",
	(SELECT
		"eventId",
		"matchId",
		"round",
		"court",
		"status",
		"scoreA",
		"scoreB",
		"winner",
		"startedAt",
		"completedAt",
		"gameId",
		"__KEY_rows",
		"__FK_rows",
		(SELECT
			"@Value",
			"__FK_teamA"
		FROM "teamA" FK "__FK_teamA" ArrayValueAlias "@Value"),
		(SELECT
			"@Value" AS "@Value_u0",
			"__FK_teamB"
		FROM "teamB" FK "__FK_teamB" ArrayValueAlias "@Value_u0")
	FROM "rows" PK "__KEY_rows" FK "__FK_rows")
FROM JSON (wrap on) "root" PK "__KEY_root";

[__MatchTeamA]:
LOAD
	[@Value] AS [__TeamAPlayer],
	[__FK_teamA] AS [__KEY_rows]
RESIDENT MatchesMasterTable
WHERE NOT IsNull([__FK_teamA]);

[__MatchTeamAConcat]:
LOAD
	[__KEY_rows],
	Concat([__TeamAPlayer], ', ') AS [Team A]
RESIDENT __MatchTeamA
GROUP BY [__KEY_rows];

DROP TABLE __MatchTeamA;

[__MatchTeamB]:
LOAD
	[@Value_u0] AS [__TeamBPlayer],
	[__FK_teamB] AS [__KEY_rows]
RESIDENT MatchesMasterTable
WHERE NOT IsNull([__FK_teamB]);

[__MatchTeamBConcat]:
LOAD
	[__KEY_rows],
	Concat([__TeamBPlayer], ', ') AS [Team B]
RESIDENT __MatchTeamB
GROUP BY [__KEY_rows];

DROP TABLE __MatchTeamB;

[Matches]:
LOAD
	[eventId] AS [Match Event Id],
	[matchId] AS [Match Id],
	[round] AS [Match Round],
	[court] AS [Match Court],
	[status] AS [Match Status],
	[scoreA] AS [Match Score A],
	[scoreB] AS [Match Score B],
	[winner] AS [Match Winner],
	[startedAt] AS [Match Started At],
	[completedAt] AS [Match Completed At],
	[gameId] AS [Match Game Id],
	[__KEY_rows]
RESIDENT MatchesMasterTable
WHERE NOT IsNull([__KEY_rows]);

LEFT JOIN ([Matches])
LOAD [__KEY_rows], [Team A]
RESIDENT __MatchTeamAConcat;

LEFT JOIN ([Matches])
LOAD [__KEY_rows], [Team B]
RESIDENT __MatchTeamBConcat;

DROP FIELD [__KEY_rows] FROM [Matches];
DROP TABLES MatchesMasterTable, __MatchTeamAConcat, __MatchTeamBConcat;

// The Current Event, until ticket 16 ships a stored current-Event flag.
[__CurrentEvent]:
LOAD
	[Event Id] AS [__CurrentEventId],
	[Event Courts] AS [__CurrentEventCourts]
RESIDENT Events
WHERE [Is Current Event] = 'True';

LET vCurrentEventId = Peek('__CurrentEventId', 0, '__CurrentEvent');
LET vCurrentEventCourts = Peek('__CurrentEventCourts', 0, '__CurrentEvent');
DROP TABLE __CurrentEvent;

[Courts]:
LOAD
	RecNo() AS [Court]
AUTOGENERATE $(vCurrentEventCourts);

LEFT JOIN ([Courts])
LOAD
	[Match Court] AS [Court],
	[Match Id] AS [In Progress Match Id],
	[Match Round] AS [In Progress Round],
	[Match Score A] AS [In Progress Score A],
	[Match Score B] AS [In Progress Score B],
	[Match Started At] AS [In Progress Started At],
	[Team A] AS [In Progress Team A],
	[Team B] AS [In Progress Team B]
RESIDENT Matches
WHERE [Match Event Id] = '$(vCurrentEventId)' AND [Match Status] = 'in_progress';

[__NextScheduled]:
LOAD
	[Match Court] AS [Court],
	[Match Round] AS [Next Round],
	[Match Id] AS [Next Match Id],
	[Team A] AS [Next Team A],
	[Team B] AS [Next Team B]
RESIDENT Matches
WHERE [Match Event Id] = '$(vCurrentEventId)' AND [Match Status] = 'scheduled';

[__NextScheduledRound]:
LOAD
	Court,
	Min([Next Round]) AS [Next Round]
RESIDENT __NextScheduled
GROUP BY Court;

LEFT JOIN ([__NextScheduledRound])
LOAD
	Court,
	[Next Round],
	[Next Match Id],
	[Next Team A],
	[Next Team B]
RESIDENT __NextScheduled;

DROP TABLE __NextScheduled;

LEFT JOIN ([Courts])
LOAD *
RESIDENT __NextScheduledRound;

DROP TABLE __NextScheduledRound;

[__CourtsFinal]:
LOAD
	*,
	If(IsNull([In Progress Match Id]), -1, 0) AS [Is Idle]
RESIDENT Courts;

DROP TABLE Courts;
RENAME TABLE __CourtsFinal TO Courts;

// Matches' Round/Court only build Courts above. Left in, they formed a synthetic key with
// LeaderboardResults' Round/Court (Round 1 / Court 1 of every Event linked together) and,
// nested with Event Id, orphaned a standalone game's results row from its Leaderboard Match Id.
DROP FIELDS [Match Round], [Match Court] FROM Matches;

///$tab Leaderboard
LIB CONNECT TO 'PaddlePoint Analytics - Leaderboard Players';

LeaderboardPlayersMasterTable:
SQL SELECT
    "__KEY_root",
    (SELECT "matchId", "eventId", "team", "playerName", "__KEY_rows", "__FK_rows"
     FROM "rows" PK "__KEY_rows" FK "__FK_rows")
FROM JSON (wrap on) "root" PK "__KEY_root";

[__LeaderboardPlayersRaw]:
LOAD [matchId] AS [Leaderboard Match Id], [eventId] AS [Event Id], [team] AS [Leaderboard Team],
     Trim([playerName]) AS [__Player Name], Lower(Trim([playerName])) AS [Player Key]
RESIDENT LeaderboardPlayersMasterTable
WHERE NOT IsNull([__FK_rows]);
DROP TABLE LeaderboardPlayersMasterTable;

[Player Variations]:
LOAD [Player Key], [__Player Name] AS [Recorded Player Name]
RESIDENT __LeaderboardPlayersRaw;

[Player]:
LOAD [Player Key], MinString([__Player Name]) AS [Player]
RESIDENT __LeaderboardPlayersRaw
GROUP BY [Player Key];

[LeaderboardPlayers]:
LOAD [Leaderboard Match Id], [Event Id], [Leaderboard Team], [Player Key]
RESIDENT __LeaderboardPlayersRaw;
DROP TABLE __LeaderboardPlayersRaw;

LIB CONNECT TO 'PaddlePoint Analytics - Leaderboard Results';

LeaderboardResultsMasterTable:
SQL SELECT
    "__KEY_root",
    (SELECT "matchId", "eventId", "winner", "teamAScore", "teamBScore", "targetScore", "durationSeconds", "completedAt", "round", "court", "sideOuts", "rallyCount", "teamALongestRun", "teamBLongestRun", "__KEY_rows", "__FK_rows"
     FROM "rows" PK "__KEY_rows" FK "__FK_rows")
FROM JSON (wrap on) "root" PK "__KEY_root";

[LeaderboardResults]:
// Keyed on Leaderboard Match Id alone; Event Id reaches results through LeaderboardPlayers.
LOAD [matchId] AS [Leaderboard Match Id], [winner] AS [Leaderboard Winner],
     [teamAScore] AS [Team A Score], [teamBScore] AS [Team B Score], [targetScore] AS [Target Score],
     [durationSeconds] AS [Duration Seconds], [round] AS [Match Round], [court] AS [Match Court],
     [sideOuts] AS [Side Outs], [rallyCount] AS [Rally Count], [teamALongestRun] AS [Team A Longest Run], [teamBLongestRun] AS [Team B Longest Run],
     Date(Floor(Timestamp#([completedAt], 'YYYY-MM-DDThh:mm:ss.fffZ') + 8/24)) AS [Match Date], Hour(Timestamp#([completedAt], 'YYYY-MM-DDThh:mm:ss.fffZ') + 8/24) AS [Match Hour]
RESIDENT LeaderboardResultsMasterTable
WHERE NOT IsNull([__FK_rows]);
DROP TABLE LeaderboardResultsMasterTable;

///$tab Player Performance
// Partners: the other Player(s) recorded on the same Team in the same Match.
// Excludes rows with a blank/missing Team (a data-quality anomaly seen in one
// standalone Match) so they can never self-pair.
[__TeammatePairs]:
LOAD [Leaderboard Match Id], [Leaderboard Team], [Player Key] AS [__PlayerA]
RESIDENT LeaderboardPlayers
WHERE [Leaderboard Team] = 'A' OR [Leaderboard Team] = 'B';

LEFT JOIN ([__TeammatePairs])
LOAD [Leaderboard Match Id], [Leaderboard Team], [Player Key] AS [__PlayerB]
RESIDENT LeaderboardPlayers
WHERE [Leaderboard Team] = 'A' OR [Leaderboard Team] = 'B';

[__PlayerNameMap]:
MAPPING LOAD [Player Key], [Player]
RESIDENT Player;

[Partners]:
LOAD
	[Leaderboard Match Id],
	[__PlayerA] AS [Player Key],
	[__PlayerB] AS [Partner Key],
	ApplyMap('__PlayerNameMap', [__PlayerB]) AS [Partner]
RESIDENT __TeammatePairs
WHERE [__PlayerA] <> [__PlayerB];
DROP TABLE __TeammatePairs;

// Opponents: every Player recorded on the other Team in the same Match.
[__TeamARows]:
LOAD [Leaderboard Match Id], [Player Key] AS [__PKA]
RESIDENT LeaderboardPlayers
WHERE [Leaderboard Team] = 'A';

LEFT JOIN ([__TeamARows])
LOAD [Leaderboard Match Id], [Player Key] AS [__PKB]
RESIDENT LeaderboardPlayers
WHERE [Leaderboard Team] = 'B';

[__OpponentPairs]:
LOAD [Leaderboard Match Id], [__PKA] AS [Player Key], [__PKB] AS [Opponent Key]
RESIDENT __TeamARows;

CONCATENATE([__OpponentPairs])
LOAD [Leaderboard Match Id], [__PKB] AS [Player Key], [__PKA] AS [Opponent Key]
RESIDENT __TeamARows;
DROP TABLE __TeamARows;

[Opponents]:
LOAD
	[Leaderboard Match Id],
	[Player Key],
	[Opponent Key],
	ApplyMap('__PlayerNameMap', [Opponent Key]) AS [Opponent]
RESIDENT __OpponentPairs;
DROP TABLE __OpponentPairs;

///$tab Partnership Analysis
// One row per Match per unordered pair (canonical direction: Player Key < Partner
// Key) so Count(DISTINCT [Leaderboard Match Id]) counts a Partnership's Matches
// together once, not once per Player. Win/Loss/Score measures for Partner,
// Opponent and Partnership dimensions all reuse ticket 06's own Wins/Losses/
// Points For/Points Against/Win %/Point Difference measures directly — those
// already resolve the selected Player's own Team via the shared Leaderboard
// Match Id + Player Key association, so no duplicate per-row outcome fields are
// needed here (an earlier version duplicated them into Partners/Opponents/
// Partnerships under identical field names, which created a Qlik synthetic key
// across the three tables and silently corrupted aggregates).
[Partnerships]:
LOAD
	[Leaderboard Match Id],
	[Player Key],
	[Partner Key],
	ApplyMap('__PlayerNameMap', [Player Key]) & ' & ' & [Partner] AS [Partnership]
RESIDENT Partners
WHERE [Player Key] < [Partner Key];

// Split into two real script-level tables (not a calculated-dimension null/else
// branch) so "below threshold" partnerships are simply absent rows, never a
// stray null-labelled row that a raw hypercube read would otherwise show.
[__PartnershipMatchCounts]:
LOAD [Partnership], Count(DISTINCT [Leaderboard Match Id]) AS [Partnership Matches Together]
RESIDENT Partnerships
GROUP BY [Partnership];

LEFT JOIN (Partnerships)
LOAD [Partnership], [Partnership Matches Together]
RESIDENT __PartnershipMatchCounts;
DROP TABLE __PartnershipMatchCounts;

[RankedPartnerships]:
LOAD
	[Leaderboard Match Id],
	[Player Key],
	[Partnership] AS [Ranked Partnership]
RESIDENT Partnerships
WHERE [Partnership Matches Together] >= 3;

[UnrankedPartnerships]:
LOAD
	[Leaderboard Match Id],
	[Player Key],
	[Partnership] AS [Unranked Partnership]
RESIDENT Partnerships
WHERE [Partnership Matches Together] < 3;
