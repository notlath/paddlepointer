# Qlik M2M Impersonation OAuth Client Credentials
QLIK_M2M_CLIENT_ID=
QLIK_M2M_CLIENT_SECRET=
QLIK_EVENT_VIEWER_SUBJECT=

# Qlik triggered automation "PaddlePoint Reload on Match Finish" (Start block, run mode Triggered).
# Leave empty to rely on the 15-minute scheduled reload only.
QLIK_RELOAD_TRIGGER_URL=
QLIK_RELOAD_TRIGGER_TOKEN=

# Analytics REST Connector Key. Required: with it empty, every /api/qlik/* request is refused.
ANALYTICS_KEY=

# Database. Leave empty locally (127.0.0.1, root, no password). Production sets all of them,
# with a MySQL user limited to the app's database.
PP_DB_HOST=
PP_DB_NAME=
PP_DB_USER=
PP_DB_PASS=

# Local Test DB Port
PP_TEST_DB_PORT=3306

